# ==============================================================================
# INSTITUTE MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or backend/.env and customize the values.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Client Origins (CORS)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
MOBILE_APP_URL=http://localhost:8081

# Database Configuration (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@localhost:3306/institute_management_db"

# JWT Secrets & Tokens
JWT_ACCESS_SECRET=super_secret_access_token_key_change_me_in_production
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Root / Default Tenant Config
DEFAULT_INSTITUTE_CODE=MAIN_CAMPUS
DEFAULT_INSTITUTE_NAME="Main Academy Campus"

# Admin Initial Seed Credentials
ADMIN_DEFAULT_EMAIL=admin@institute.local
ADMIN_DEFAULT_PASSWORD=AdminSecurePassword123!
